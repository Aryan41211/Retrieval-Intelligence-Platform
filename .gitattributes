# Normalise line endings so files that are executed inside Linux containers are
# never checked out with CRLF. A \r in a shebang makes the kernel fail with
# "env: 'sh\r': No such file or directory".

* text=auto eol=lf

*.sh    text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf

# Binary assets must never be translated.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.faiss binary
*.index binary
*.pkl binary
