# ==============================================================================
# Retrieval Intelligence Platform - environment configuration
#
# GENERATED FILE - do not edit by hand.
#   Regenerate with: python scripts/generate_env_example.py
#
# Copy to .env and fill in the values marked REQUIRED.
#   cp .env.example .env
#
# Commented-out keys are optional: leaving them commented means "unset", which
# is what the code expects. Assigning them an empty value is NOT the same thing
# and will fail validation for numeric settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# API / server
# Server binding, CORS, rate limiting, logging, security headers.
# ------------------------------------------------------------------------------
# Deployment environment; drives security and docs defaults.
# Type: 'development' | 'staging' | 'production'
API_ENVIRONMENT=development

# Human-readable service name used in logs and metrics.
API_APP_NAME=retrieval-intelligence-platform

# URL prefix for all versioned API routers.
API_API_PREFIX=/api/v1

# Bind host for the HTTP server.
API_HOST=0.0.0.0

# Bind port for the HTTP server.
# Type: int
API_PORT=8000

# Enable debug behaviour. Automatically disabled in production.
# Type: bool
API_DEBUG=false

# Expose /docs, /redoc and /openapi.json. Disabled in production by default.
# Type: bool
API_DOCS_ENABLED=true

# Max request processing time in seconds.
# Type: int
API_REQUEST_TIMEOUT_SECONDS=30

# Maximum accepted request body size in MB.
# Type: int
API_MAX_REQUEST_SIZE_MB=100

# Allowed CORS origins. Avoid '*' together with credentials in production.
API_CORS_ORIGINS=["*"]

# Allow credentialed CORS requests.
# Type: bool
API_CORS_CREDENTIALS=false

# Allowed CORS HTTP methods.
API_CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]

# Allowed CORS request headers.
API_CORS_HEADERS=["*"]

# Sustained requests allowed per client IP per minute.
# Type: int
API_RATE_LIMIT_PER_MINUTE=120

# Burst capacity above the sustained rate per client IP.
# Type: int
API_RATE_LIMIT_BURST=20

# Enable the in-memory per-IP rate limiter. Disable in tests.
# Type: bool
API_RATE_LIMIT_ENABLED=true

# Stricter sustained rate for authentication endpoints (per client IP).
# Type: int
API_RATE_LIMIT_AUTH_PER_MINUTE=10

# Maximum client buckets held in memory before idle ones are evicted.
# Type: int
API_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

# Honour X-Forwarded-For when determining the client IP. Enable ONLY when every request passes through a proxy you control, otherwise clients can spoof their address and bypass rate limiting.
# Type: bool
API_TRUST_PROXY_HEADERS=false

# Number of trusted proxies in front of the app. The client IP is taken this many hops from the right of X-Forwarded-For, which spoofed entries cannot reach.
# Type: int
API_TRUSTED_PROXY_COUNT=1

# Permitted Host header values; required in production. List the hostnames browsers use to reach the app, not the API's own service name: the bundled nginx forwards the original Host, so behind it this is the frontend's hostname. Health probes are exempt (they arrive by IP).
API_TRUSTED_HOSTS=["*"]

# Require a bearer token on /metrics. Disable only on a private network.
# Type: bool
API_METRICS_REQUIRE_AUTH=true

# Shared token accepted by /metrics (Authorization: Bearer <token>). When unset and metrics_require_auth is true, /metrics requires a normal user JWT.
# SECRET - never commit a real value.
API_METRICS_TOKEN=

# Minimum log level for the root logger.
# Type: 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL'
API_LOG_LEVEL=INFO

# Structured JSON logging or human-readable text.
# Type: 'json' | 'text'
API_LOG_FORMAT=json

# Optional file path for logs; stdout/stderr when unset.
# API_LOG_FILE=

# Emit baseline HTTP security headers on every response.
# Type: bool
API_SECURITY_HEADERS_ENABLED=true

# Emit Strict-Transport-Security. Enable only behind TLS.
# Type: bool
API_HSTS_ENABLED=false

# Content-Security-Policy value applied to HTML responses.
API_CSP_POLICY=default-src 'self'

# Expose a Prometheus /metrics endpoint.
# Type: bool
API_PROMETHEUS_ENABLED=true

# Header used to carry request correlation IDs.
API_CORRELATION_HEADER=X-Correlation-ID


# ------------------------------------------------------------------------------
# Enterprise / authentication
# JWT signing, token lifetimes, OAuth, registration.
# ------------------------------------------------------------------------------
# Deployment environment (dev/staging/prod).
ENTERPRISE_ENVIRONMENT=development

# Secret used to sign JWTs. REQUIRED and must be strong in production.
# REQUIRED - never commit a real value.
ENTERPRISE_JWT_SECRET_KEY=

# JWT signing algorithm.
ENTERPRISE_JWT_ALGORITHM=HS256

# Access token lifetime in seconds.
# Type: int
ENTERPRISE_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds.
# Type: int
ENTERPRISE_REFRESH_TOKEN_TTL_SECONDS=604800

# Password reset token lifetime.
# Type: int
ENTERPRISE_PASSWORD_RESET_TTL_SECONDS=3600

# Email verification token lifetime.
# Type: int
ENTERPRISE_EMAIL_VERIFICATION_TTL_SECONDS=86400

# Allow open self-registration.
# Type: bool
ENTERPRISE_REGISTRATION_ENABLED=true

# Require verified email before issuing tokens.
# Type: bool
ENTERPRISE_EMAIL_VERIFICATION_REQUIRED=false

# Role assigned to new users.
ENTERPRISE_DEFAULT_ROLE=member

# Persist audit/activity logs.
# Type: bool
ENTERPRISE_AUDIT_ENABLED=true

# Enable OAuth login providers.
# Type: bool
ENTERPRISE_OAUTH_ENABLED=false

# Google OAuth client id.
# ENTERPRISE_OAUTH_GOOGLE_CLIENT_ID=

# Google OAuth client secret (secret).
# SECRET - never commit a real value.
ENTERPRISE_OAUTH_GOOGLE_CLIENT_SECRET=

# OAuth callback redirect URI.
# ENTERPRISE_OAUTH_GOOGLE_REDIRECT_URI=

# SMTP host for outbound email.
# ENTERPRISE_SMTP_HOST=

# From address for outbound email.
# ENTERPRISE_SMTP_FROM=


# ------------------------------------------------------------------------------
# Generation (LLM)
# Provider selection and credentials for answer generation.
# ------------------------------------------------------------------------------
# LLM provider: openai, openai_compatible, anthropic, ollama, nim, or 'fake' for a deterministic development stub (rejected in production).
GENERATION_PROVIDER=fake

# Model name for the selected provider
GENERATION_MODEL_NAME=fake-model

# Sampling temperature
# Type: float
GENERATION_TEMPERATURE=0.2

# Maximum tokens to generate
# Type: int
GENERATION_MAX_TOKENS=512

# Generation timeout in seconds
# Type: float
GENERATION_TIMEOUT_S=60.0

# API key for the selected provider (GENERATION_API_KEY). Secret.
# SECRET - never commit a real value.
GENERATION_API_KEY=

# Override the provider API base URL. Defaults per provider when unset.
# GENERATION_BASE_URL=

# Optional OpenAI organization id.
# GENERATION_ORGANIZATION=

# Optional OpenAI project id.
# GENERATION_PROJECT=

# Anthropic API version header.
GENERATION_ANTHROPIC_VERSION=2023-06-01

# Retry attempts for transient provider failures.
# Type: int
GENERATION_MAX_RETRIES=3


# ------------------------------------------------------------------------------
# Embeddings
# Embedding model used for indexing and query encoding.
# ------------------------------------------------------------------------------
# Embedding provider identifier.
EMBEDDING_PROVIDER=sentence_transformers

# Sentence-transformers model name.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Torch device override (e.g. 'cpu', 'cuda'). Auto when unset.
# EMBEDDING_DEVICE=

# Embedding batch size.
# Type: int
EMBEDDING_BATCH_SIZE=32


# ------------------------------------------------------------------------------
# Vector store
# Index persistence and defaults.
# ------------------------------------------------------------------------------
# Vector store provider (faiss, chromadb, etc.)
VECTOR_STORE_PROVIDER=faiss

# Directory for storing vector indexes
VECTOR_STORE_STORAGE_DIR=./data/vectorstore

# Default index type (flat, hnsw, ivf, pq)
VECTOR_STORE_INDEX_TYPE=flat

# Default distance metric (cosine, euclidean, inner_product)
VECTOR_STORE_DISTANCE_METRIC=cosine

# Automatically save index after modifications
# Type: bool
VECTOR_STORE_AUTO_SAVE=true

# Automatically load index on initialization
# Type: bool
VECTOR_STORE_AUTO_LOAD=true


# ------------------------------------------------------------------------------
# Retrieval
# Top-k, thresholds and filters for dense retrieval.
# ------------------------------------------------------------------------------
# Default number of results to retrieve
# Type: int
RETRIEVAL_TOP_K=10

# Minimum similarity score threshold
# Type: float
# RETRIEVAL_SIMILARITY_THRESHOLD=

# Batch size for batch retrieval operations
# Type: int
RETRIEVAL_BATCH_SIZE=32

# Automatically load index on initialization
# Type: bool
RETRIEVAL_AUTO_LOAD=true

# Automatically save index after modifications
# Type: bool
RETRIEVAL_AUTO_SAVE=true

# Default language filters
# RETRIEVAL_DEFAULT_LANGUAGES=

# Default source filename filters
# RETRIEVAL_DEFAULT_SOURCE_FILENAMES=


# ------------------------------------------------------------------------------
# Hybrid retrieval
# Enable the BM25 + RRF + rerank pipeline.
# ------------------------------------------------------------------------------
# Enable IntelligentRetrievalPipeline
# Type: bool
INTELLIGENT_RETRIEVAL_ENABLED=false

# Enable dense retrieval stage
# Type: bool
INTELLIGENT_RETRIEVAL_DENSE_ENABLED=true

# Enable sparse BM25 retrieval stage
# Type: bool
INTELLIGENT_RETRIEVAL_SPARSE_ENABLED=true

# Weight for dense in fusion (optional)
# Type: float
INTELLIGENT_RETRIEVAL_RETRIEVAL_WEIGHT_DENSE=1.0

# Weight for sparse in fusion (optional)
# Type: float
INTELLIGENT_RETRIEVAL_RETRIEVAL_WEIGHT_SPARSE=1.0


# ------------------------------------------------------------------------------
# Hybrid: BM25
# Sparse retrieval parameters.
# ------------------------------------------------------------------------------
# Enable BM25 sparse retrieval
# Type: bool
BM25_ENABLED=true

# BM25 k1 parameter
# Type: float
BM25_K1=1.5

# BM25 b parameter
# Type: float
BM25_B=0.75

# Lowercase query and documents for BM25
# Type: bool
BM25_LOWERCASE=true

# If true, apply request/language filters to BM25 corpus during scoring
# Type: bool
BM25_ENABLED_QUERY_LANGUAGE_FILTER=false

# Rebuild BM25 index on start (in-memory).
# Type: bool
BM25_REBUILD_ON_START=false


# ------------------------------------------------------------------------------
# Hybrid: RRF fusion
# Reciprocal rank fusion parameters.
# ------------------------------------------------------------------------------
# Enable RRF fusion for hybrid retrieval
# Type: bool
RRF_ENABLED=true

# RRF k parameter
# Type: int
RRF_K=60

# Remove duplicate chunks in fused results
# Type: bool
RRF_REMOVE_DUPLICATES=true

# Preserve stable ordering for ties
# Type: bool
RRF_STABLE_RANKING=true


# ------------------------------------------------------------------------------
# Hybrid: cross-encoder rerank
# Optional reranking stage.
# ------------------------------------------------------------------------------
# Enable cross-encoder reranking stage
# Type: bool
CROSS_ENCODER_ENABLED=false

# Reranker provider
CROSS_ENCODER_PROVIDER=sentence_transformers

# CrossEncoder model name
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of top candidates to rerank
# Type: int
CROSS_ENCODER_TOP_N=20

# CrossEncoder batch size
# Type: int
CROSS_ENCODER_BATCH_SIZE=16

# Max text length for cross-encoder inputs
# Type: int
CROSS_ENCODER_MAX_LENGTH=512


# ------------------------------------------------------------------------------
# Hybrid: query expansion
# Lightweight query expansion.
# ------------------------------------------------------------------------------
# Enable query expansion stage
# Type: bool
QUERY_EXPANSION_ENABLED=true

# Enable synonym expansion
# Type: bool
QUERY_EXPANSION_SYNONYMS_ENABLED=true

# Remove stopwords from expanded query
# Type: bool
QUERY_EXPANSION_STOPWORD_CLEANUP=true

# Cleanup punctuation
# Type: bool
QUERY_EXPANSION_PUNCTUATION_CLEANUP=true

# Lowercase query for normalization
# Type: bool
QUERY_EXPANSION_LOWERCASE=true

# Synonym mapping for lightweight expansion
# Type: list[str]
QUERY_EXPANSION_SYNONYMS={"ai": ["artificial intelligence"], "llm": ["large language model"], "retrieval": ["search", "information retrieval"]}


# ------------------------------------------------------------------------------
# Hybrid: dynamic top-k
# Adaptive result-count selection.
# ------------------------------------------------------------------------------
# Enable dynamic top-k selection
# Type: bool
DYNAMIC_TOP_K_ENABLED=true

# Minimum number of final chunks
# Type: int
DYNAMIC_TOP_K_MIN_K=5

# Maximum number of final chunks
# Type: int
DYNAMIC_TOP_K_MAX_K=30

# Minimum confidence to increase k
# Type: float
DYNAMIC_TOP_K_MIN_CONFIDENCE=0.2

# Maximum confidence to cap k
# Type: float
DYNAMIC_TOP_K_MAX_CONFIDENCE=0.9


# ------------------------------------------------------------------------------
# Ingestion
# Document loading limits and supported formats.
# ------------------------------------------------------------------------------
# Type: int
INGESTION_MAX_FILE_SIZE_MB=100

INGESTION_SUPPORTED_EXTENSIONS=[".pdf", ".docx", ".txt", ".md", ".markdown"]

INGESTION_DEFAULT_ENCODING=utf-8

INGESTION_DEFAULT_LANGUAGE=en

# Type: bool
INGESTION_VALIDATE_CHECKSUM=true


# ------------------------------------------------------------------------------
# Preprocessing
# Text normalisation.
# ------------------------------------------------------------------------------
# Type: bool
PREPROCESSING_NORMALIZE_UNICODE=true

# Type: bool
PREPROCESSING_NORMALIZE_WHITESPACE=true

# Type: bool
PREPROCESSING_REMOVE_EXCESSIVE_BLANK_LINES=true

# Type: int
PREPROCESSING_MAX_CONSECUTIVE_BLANKS=2

# Type: bool
PREPROCESSING_PRESERVE_PARAGRAPHS=true


# ------------------------------------------------------------------------------
# Embedding validation
# Optional embedding quality checks.
# ------------------------------------------------------------------------------
# Expected embedding dimension
# Type: int
# EMBEDDING_VALIDATION_EXPECTED_DIMENSION=

# Tolerance threshold for duplicate detection (0.0 = exact only)
# Type: float
EMBEDDING_VALIDATION_DUPLICATE_TOLERANCE=0.0

# Enable embedding validation
# Type: bool
EMBEDDING_VALIDATION_VALIDATION_ENABLED=true

# Raise exceptions on validation failures instead of collecting errors
# Type: bool
EMBEDDING_VALIDATION_STRICT_MODE=false

# Treat all validation failures as warnings
# Type: bool
EMBEDDING_VALIDATION_WARNING_MODE=false


# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# SQLAlchemy async URL. A synchronous driver is upgraded automatically, but
# prefer the explicit async form.
#   sqlite+aiosqlite:///./rip.db
#   postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./rip.db
