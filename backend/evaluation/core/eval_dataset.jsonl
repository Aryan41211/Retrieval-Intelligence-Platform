# Retrieval Intelligence Platform - Ragas Evaluation Dataset

# This file contains human-validated evaluation queries for Ragas evaluation.
# Format: JSONL, one object per line.
# Fields:
#   - query_id: Unique identifier
#   - question: User query
#   - ground_truth: Reference answer
#   - contexts: Retrieved context chunks used to ground the answer
#   - label_source: "human-validated"
#   - metadata: Additional metadata (annotator, category, difficulty, etc.)

{"query_id": "rag-eval-001", "query_text": "What is machine learning?", "ground_truth": "Machine learning is a subset of artificial intelligence that enables systems to learn and improve from experience without being explicitly programmed. It uses algorithms to analyze data, identify patterns, and make decisions with minimal human intervention.", "contexts": ["Machine learning is a branch of artificial intelligence (AI) and computer science which focuses on the use of data and algorithms to imitate the way humans learn, gradually improving its accuracy."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rag-eval-002", "query_text": "How does FAISS vector search work?", "ground_truth": "FAISS (Facebook AI Similarity Search) is a library for efficient similarity search and clustering of dense vectors. It uses various indexing methods like IVF (Inverted File Index) and HNSW (Hierarchical Navigable Small World) to quickly find nearest neighbors in high-dimensional spaces without exhaustive search.", "contexts": ["FAISS is a library for efficient similarity search and clustering of dense vectors. It contains algorithms that search in sets of vectors of any size, up to ones that possibly do not fit in RAM."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rag-eval-003", "query_text": "What is Retrieval-Augmented Generation (RAG)?", "ground_truth": "Retrieval-Augmented Generation (RAG) is an AI framework that retrieves relevant documents from an external knowledge source to ground large language model responses, reducing hallucinations and improving factual accuracy by providing relevant context to the LLM before generation.", "contexts": ["Retrieval-Augmented Generation (RAG) is the process of optimizing the output of a large language model by referencing an authoritative knowledge base outside of its training data sources before generating a response."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "rag", "difficulty": "easy"}}
{"query_id": "rag-eval-004", "query_text": "What is BM25 in information retrieval?", "ground_truth": "BM25 is a ranking function used by search engines to estimate the relevance of documents to a given search query. It is based on the probabilistic retrieval framework and considers term frequency, inverse document frequency, and document length normalization.", "contexts": ["BM25 is a ranking function used by search engines to estimate the relevance of documents to a given search query. It is based on the probabilistic retrieval framework developed in the 1970s and 1980s by Stephen Robertson, Karen Spärck Jones, and others."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rag-eval-005", "query_text": "What is Reciprocal Rank Fusion (RRF)?", "ground_truth": "Reciprocal Rank Fusion (RRF) is a rank fusion method that combines results from multiple retrieval systems by assigning scores based on the reciprocal of each result's rank. The formula is 1/(k + rank), where k is a constant (typically 60), and scores from multiple systems are summed to produce a fused ranking.", "contexts": ["Reciprocal Rank Fusion (RRF) is a method for combining the results of multiple search engines. It assigns each document a score based on its rank in each individual result list, using the formula 1/(k + rank), where k is a constant typically set to 60."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rag-eval-006", "query_text": "What is a vector database?", "ground_truth": "A vector database is a type of database that stores data as high-dimensional vectors (embeddings) and enables similarity search by comparing vector representations using distance metrics like cosine similarity or Euclidean distance. It is commonly used for storing embeddings from machine learning models for semantic search.", "contexts": ["A vector database is a type of database that stores data as high-dimensional vectors (embeddings), which are numerical representations of data such as text, images, or audio. Vector databases enable similarity search by comparing vector representations using distance metrics like cosine similarity."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "database", "difficulty": "easy"}}
{"query_id": "rag-eval-007", "query_text": "What is cosine similarity?", "ground_truth": "Cosine similarity is a measure of similarity between two non-zero vectors in an inner product space. It measures the cosine of the angle between two vectors, ranging from -1 (completely opposite) to 1 (identical), with 0 indicating orthogonality. It is commonly used in information retrieval to measure document similarity.", "contexts": ["Cosine similarity is a measure of similarity between two non-zero vectors in an inner product space that measures the cosine of the angle between them. Its value ranges from -1 to 1, where 1 means the vectors point in the same direction, 0 means they are orthogonal, and -1 means they point in opposite directions."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "mathematics", "difficulty": "easy"}}
{"query_id": "rag-eval-008", "query_text": "What is sentence-transformers?", "ground_truth": "sentence-transformers is a Python framework for state-of-the-art sentence and text embeddings. It provides easy-to-use methods to compute sentence embeddings that can be used for tasks like semantic textual similarity, semantic search, and paragraph embeddings.", "contexts": ["sentence-transformers is a Python framework for state-of-the-art sentence, text and image embeddings. The initial publication was in August 2019. The framework allows you to compute sentence / text embeddings for more than 100 languages."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "embeddings", "difficulty": "easy"}}
{"query_id": "rip-eval-009", "query_text": "How does logistic regression work for binary classification?", "ground_truth": "Logistic regression is a statistical method for binary classification that uses the logistic sigmoid function to model the probability of an input belonging to a particular class. It outputs values between 0 and 1, which can be interpreted as probabilities.", "contexts": ["Logistic regression uses the logistic function to map predictions to probabilities between 0 and 1 for binary classification tasks."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-010", "query_text": "What is the difference between supervised and unsupervised learning?", "ground_truth": "Supervised learning uses labeled training data to learn a mapping from inputs to outputs, while unsupervised learning finds hidden patterns in unlabeled data without predefined output labels.", "contexts": ["Supervised learning requires labeled examples, unsupervised learning works with unlabeled data to discover structure."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-011", "query_text": "What is overfitting in machine learning and how to prevent it?", "ground_truth": "Overfitting occurs when a model learns the training data too well, including noise, and fails to generalize to new data. Prevention techniques include cross-validation, regularization, early stopping, and using more training data.", "contexts": ["Overfitting happens when a model memorizes training data instead of learning patterns. Cross-validation and regularization help prevent it."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-012", "query_text": "What is precision and recall in classification evaluation?", "ground_truth": "Precision is the fraction of positive predictions that are correct (TP/(TP+FP)). Recall is the fraction of actual positives that were identified (TP/(TP+FN)). There is often a trade-off between them.", "contexts": ["Precision measures positive prediction accuracy, recall measures how many actual positives were found."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-013", "query_text": "How does k-means clustering algorithm work?", "ground_truth": "K-means clustering partitions data into k clusters by iteratively assigning points to the nearest cluster centroid and recomputing centroids until convergence. It requires specifying k in advance.", "contexts": ["K-means is an unsupervised clustering algorithm that groups data into k clusters based on similarity to centroids."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-014", "query_text": "What is PCA and when is it used?", "ground_truth": "Principal Component Analysis (PCA) is a dimensionality reduction technique that finds orthogonal components capturing maximum variance in data. It is used for visualization, noise reduction, and feature extraction before classification.", "contexts": ["PCA reduces dimensionality by projecting data onto principal components that capture maximum variance."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-015", "query_text": "What is cross-validation and why is it important?", "ground_truth": "Cross-validation is a resampling technique that partitions data into training and validation folds multiple times to estimate model performance more reliably and reduce overfitting risk.", "contexts": ["Cross-validation evaluates model performance by training and validating on different data splits multiple times."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-016", "query_text": "What is the bias-variance tradeoff?", "ground_truth": "The bias-variance tradeoff describes the tension between model simplicity (high bias, low variance) and model complexity (low bias, high variance). Good models balance both to minimize total error.", "contexts": ["Bias-variance tradeoff balances model simplicity against complexity to minimize generalization error."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-017", "query_text": "What is a decision tree in machine learning?", "ground_truth": "A decision tree is a flowchart-like structure where internal nodes represent feature tests, branches represent outcomes, and leaves represent class labels or values. It is used for both classification and regression.", "contexts": ["Decision trees use feature-based splitting to create a flowchart-like model for classification or regression."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-018", "query_text": "What is gradient descent and how does it optimize models?", "ground_truth": "Gradient descent is an optimization algorithm that iteratively adjusts model parameters in the direction of steepest descent of the loss function to minimize error. Learning rate controls step size.", "contexts": ["Gradient descent minimizes loss by updating parameters in the direction opposite to the gradient."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-019", "query_text": "What is a confusion matrix in classification?", "ground_truth": "A confusion matrix is a table showing true positives, false positives, true negatives, and false negatives. It provides a detailed breakdown of classification performance beyond simple accuracy.", "contexts": ["Confusion matrices show true/false positive/negative counts for detailed classification evaluation."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-020", "query_text": "What is TF-IDF and how is it used in information retrieval?", "ground_truth": "TF-IDF (Term Frequency-Inverse Document Frequency) is a numerical statistic that reflects how important a word is to a document in a collection. It weights frequent terms in a document down by their frequency across all documents.", "contexts": ["TF-IDF weights terms by their frequency in a document relative to their frequency across the document collection."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-021", "query_text": "What is cosine similarity and when is it used in vector search?", "ground_truth": "Cosine similarity measures the cosine of the angle between two vectors, ranging from -1 to 1. In vector search, it measures how similar two embeddings are, with 1 meaning identical direction.", "contexts": ["Cosine similarity measures vector alignment and is commonly used for semantic similarity in vector search."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "easy"}}
{"query_id": "rip-eval-022", "query_text": "What is an embedding in natural language processing?", "ground_truth": "An embedding is a dense vector representation of text that captures semantic meaning. Words or sentences with similar meanings have embeddings that are close together in vector space.", "contexts": ["Embeddings convert text into dense vectors where similar meanings are geometrically close."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "embeddings", "difficulty": "easy"}}
{"query_id": "rip-eval-023", "query_text": "What is HNSW index in vector databases?", "ground_truth": "HNSW (Hierarchical Navigable Small World) is a graph-based approximate nearest neighbor index that provides fast similarity search with high recall by creating layers of increasingly coarse graphs.", "contexts": ["HNSW is a graph-based ANN index for fast approximate nearest neighbor search in vector databases."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "hard"}}
{"query_id": "rip-eval-024", "query_text": "What is IVF index in FAISS?", "ground_truth": "IVF (Inverted File Index) in FAISS partitions vectors into coarse centroids and only searches relevant cells, trading some accuracy for much faster search on large datasets.", "contexts": ["IVF indexes partition vector space into cells for faster approximate search in FAISS."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-025", "query_text": "What is RAG (Retrieval-Augmented Generation)?", "ground_truth": "RAG combines information retrieval with text generation by retrieving relevant documents from a knowledge base and using them as context for an LLM to generate grounded answers.", "contexts": ["RAG retrieves relevant documents and uses them as context for LLM generation to reduce hallucinations."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "rag", "difficulty": "easy"}}
{"query_id": "rip-eval-026", "query_text": "What is semantic search vs keyword search?", "ground_truth": "Semantic search uses embeddings to find conceptually similar content, while keyword search matches exact terms. Semantic search handles synonyms and concepts better, keyword search is better for exact matches.", "contexts": ["Semantic search finds conceptually similar content using embeddings, keyword search matches exact terms."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "easy"}}
{"query_id": "rip-eval-027", "query_text": "What is a vector database used for?", "ground_truth": "A vector database stores high-dimensional embeddings and enables fast similarity search. It is used for semantic search, recommendation systems, and RAG applications.", "contexts": ["Vector databases store embeddings for fast similarity search in semantic search and RAG systems."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "database", "difficulty": "easy"}}
{"query_id": "rip-eval-028", "query_text": "What is chunking in document processing for RAG?", "ground_truth": "Chunking splits long documents into smaller segments before embedding. Good chunking preserves context boundaries and ensures chunks are small enough for embedding models while retaining meaning.", "contexts": ["Chunking splits documents into segments for embedding, balancing context preservation with model limits."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "rag", "difficulty": "medium"}}
{"query_id": "rip-eval-029", "query_text": "What is a citation in RAG systems and why is it important?", "ground_truth": "A citation in RAG systems points to the source document that supports a generated claim. Citations enable users to verify information and reduce trust issues with AI-generated content.", "contexts": ["Citations in RAG link generated answers to source documents for verification."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "rag", "difficulty": "easy"}}
{"query_id": "rip-eval-030", "query_text": "What is context window in LLMs?", "ground_truth": "The context window is the maximum number of tokens an LLM can process at once. It limits how much text can be provided as input, affecting how much context can be included in RAG.", "contexts": ["Context window limits the token count an LLM can process in a single pass."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-031", "query_text": "What is hallucination in language models?", "ground_truth": "Hallucination is when an LLM generates false or unsupported information presented as fact. RAG helps reduce hallucinations by grounding responses in retrieved context.", "contexts": ["Hallucination is when LLMs generate false information. RAG reduces it by grounding answers in retrieved context."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-032", "query_text": "What is embedding dimensionality and how does it affect search?", "ground_truth": "Embedding dimensionality is the size of the vector representing text. Higher dimensions capture more nuance but require more storage and computation. Common sizes are 384, 768, and 1536.", "contexts": ["Embedding dimensionality affects representation quality and search performance; common sizes range from 384 to 1536."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "embeddings", "difficulty": "medium"}}
{"query_id": "rip-eval-033", "query_text": "What is a retrieval pipeline in RAG?", "ground_truth": "A retrieval pipeline in RAG includes query processing, embedding generation, vector search, result ranking, and context construction before generation. Each stage affects final answer quality.", "contexts": ["RAG retrieval pipelines process queries through embedding, search, ranking, and context construction stages."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "rag", "difficulty": "medium"}}
{"query_id": "rip-eval-034", "query_text": "What is query expansion and when is it useful?", "ground_truth": "Query expansion adds related terms or synonyms to a user query to improve retrieval recall. It is useful when users use different terminology than the documents contain.", "contexts": ["Query expansion adds synonyms and related terms to improve retrieval recall across terminology differences."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-035", "query_text": "What is a language model and how is it trained?", "ground_truth": "A language model is trained to predict the next token in a sequence given previous tokens. Training on large text corpora enables it to learn grammar, facts, and reasoning patterns.", "contexts": ["Language models learn to predict next tokens from large text corpora, acquiring grammar and knowledge."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-036", "query_text": "What is the difference between embedding models and LLMs?", "ground_truth": "Embedding models convert text to dense vectors for similarity search, while LLMs generate text. Embeddings are used for retrieval, LLMs for generation in RAG systems.", "contexts": ["Embedding models create vectors for search, LLMs generate text. Both are used together in RAG."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "embeddings", "difficulty": "easy"}}
{"query_id": "rip-eval-037", "query_text": "What is metadata filtering in vector search?", "ground_truth": "Metadata filtering restricts vector search results to documents matching specific criteria (date, category, author). It improves relevance by narrowing the search space before similarity comparison.", "contexts": ["Metadata filtering narrows vector search by document attributes before computing similarity."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-038", "query_text": "What is a reranker in retrieval systems?", "ground_truth": "A reranker is a second-stage model that re-orders initial retrieval results using more sophisticated scoring. Cross-encoders are common rerankers that improve precision at the cost of latency.", "contexts": ["Rerankers re-order initial retrieval results using more sophisticated models like cross-encoders."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-039", "query_text": "What is context precision in RAG evaluation?", "ground_truth": "Context precision measures the proportion of retrieved context chunks that are relevant to the query. High precision means few irrelevant chunks are retrieved.", "contexts": ["Context precision measures how many retrieved chunks are actually relevant to the question."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "evaluation", "difficulty": "easy"}}
{"query_id": "rip-eval-040", "query_text": "What is context recall in RAG evaluation?", "ground_truth": "Context recall measures the proportion of relevant information from the ground truth that is present in the retrieved context. High recall means the retriever found most of the needed information.", "contexts": ["Context recall measures how much of the ground truth information is covered by retrieved context."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "evaluation", "difficulty": "easy"}}
{"query_id": "rip-eval-041", "query_text": "What is answer relevancy in RAG evaluation?", "ground_truth": "Answer relevancy measures how well the generated answer addresses the original question. It assesses whether the response stays on topic and provides useful information.", "contexts": ["Answer relevancy checks if the generated response actually answers the user's question."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "evaluation", "difficulty": "easy"}}
{"query_id": "rip-eval-042", "query_text": "What is faithfulness in RAG evaluation?", "ground_truth": "Faithfulness measures whether all claims in the generated answer are supported by the retrieved context. It detects hallucinations by checking answer statements against source documents.", "contexts": ["Faithfulness verifies that answer claims are grounded in retrieved context, not fabricated."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "evaluation", "difficulty": "easy"}}
{"query_id": "rip-eval-043", "query_text": "What is hybrid search and why use it?", "ground_truth": "Hybrid search combines dense (semantic) and sparse (keyword/BM25) retrieval. Dense handles concepts and synonyms, sparse handles exact terms and proper nouns. Together they outperform either alone.", "contexts": ["Hybrid search combines semantic and keyword retrieval for better coverage of different query types."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-044", "query_text": "What is Reciprocal Rank Fusion (RRF)?", "ground_truth": "RRF combines results from multiple retrieval systems by scoring each result as 1/(k+rank) where k is typically 60. Scores from all systems are summed to produce a fused ranking.", "contexts": ["RRF combines multiple retrieval results using reciprocal rank scoring with k=60 typically."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-045", "query_text": "What is weighted score fusion in hybrid retrieval?", "ground_truth": "Weighted score fusion normalizes scores from each retrieval system to [0,1] and combines them with configurable weights. Dense retrieval typically gets higher weight since it outperforms lexical methods on semantic queries.", "contexts": ["Weighted fusion combines normalized retrieval scores with configurable per-system weights."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-046", "query_text": "What is a vector index and why is it needed?", "ground_truth": "A vector index organizes embeddings for fast similarity search. Without an index, finding nearest neighbors requires scanning all vectors (O(n)). Indexes like HNSW and IVF make search sub-linear.", "contexts": ["Vector indexes enable fast nearest-neighbor search without scanning all vectors."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-047", "query_text": "What is approximate nearest neighbor search?", "ground_truth": "Approximate nearest neighbor (ANN) search finds vectors that are close to the query but not guaranteed to be the exact nearest neighbors. It trades perfect accuracy for much faster search on large datasets.", "contexts": ["ANN search finds near neighbors quickly with small accuracy tradeoffs for large-scale search."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "medium"}}
{"query_id": "rip-eval-048", "query_text": "What is the difference between recall and precision in retrieval?", "ground_truth": "Retrieval recall measures how many relevant documents were found out of all relevant documents. Precision measures how many retrieved documents are actually relevant. They often trade off against each other.", "contexts": ["Recall measures coverage of relevant documents, precision measures accuracy of retrieved documents."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "easy"}}
{"query_id": "rip-eval-049", "query_text": "What is nDCG and when is it used?", "ground_truth": "nDCG (Normalized Discounted Cumulative Gain) measures ranking quality by considering both relevance and position. Higher-ranked relevant documents contribute more to the score. It is used in information retrieval evaluation.", "contexts": ["nDCG evaluates ranking quality by weighting relevant results by their position in the list."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "evaluation", "difficulty": "medium"}}
{"query_id": "rip-eval-050", "query_text": "What is MRR (Mean Reciprocal Rank) in retrieval?", "ground_truth": "MRR measures the average reciprocal rank of the first relevant result across queries. If the first relevant result is at position 1, score is 1.0; position 2 gives 0.5, position 3 gives 0.33, etc.", "contexts": ["MRR averages the reciprocal rank of the first relevant result across multiple queries."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "evaluation", "difficulty": "easy"}}
{"query_id": "rip-eval-051", "query_text": "What is a knowledge base in RAG systems?", "ground_truth": "A knowledge base in RAG is the collection of documents from which relevant context is retrieved. It can include FAQs, manuals, articles, and other structured or unstructured information sources.", "contexts": ["Knowledge bases are document collections used as context sources in RAG systems."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "rag", "difficulty": "easy"}}
{"query_id": "rip-eval-052", "query_text": "What is document ingestion pipeline?", "ground_truth": "A document ingestion pipeline processes raw documents through loading, parsing, chunking, embedding, and storage in a vector database. It prepares documents for retrieval in RAG systems.", "contexts": ["Document ingestion pipelines process documents through parsing, chunking, embedding, and vector storage."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "rag", "difficulty": "medium"}}
{"query_id": "rip-eval-053", "query_text": "What is query understanding in RAG?", "ground_truth": "Query understanding analyzes user queries to determine intent, extract entities, and decide which retrieval strategy to use. It improves retrieval by matching query type to search method.", "contexts": ["Query understanding determines user intent and selects appropriate retrieval strategies."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "rag", "difficulty": "medium"}}
{"query_id": "rip-eval-054", "query_text": "What is a system prompt in LLM applications?", "ground_truth": "A system prompt is an initial instruction given to an LLM to define its behavior, role, and constraints. In RAG, system prompts guide how the model should use retrieved context to generate answers.", "contexts": ["System prompts define LLM behavior and guide context usage in RAG generation."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-055", "query_text": "What is few-shot prompting and how does it help?", "ground_truth": "Few-shot prompting provides examples of input-output pairs in the prompt to guide the LLM's output format and behavior. It helps the model understand the desired task pattern without fine-tuning.", "contexts": ["Few-shot prompting uses examples to guide LLM output format without fine-tuning."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-056", "query_text": "What is temperature in LLM sampling?", "ground_truth": "Temperature controls randomness in LLM output. Lower temperature (0.1-0.3) makes output more deterministic and focused, higher temperature (0.7-1.0) makes it more creative and varied.", "contexts": ["Temperature controls LLM output randomness; lower is more deterministic, higher is more creative."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-057", "query_text": "What is a token in language models?", "ground_truth": "A token is the basic unit of text that language models process. Tokens can be words, subwords, or characters. Models have context window limits measured in tokens.", "contexts": ["Tokens are the basic text units processed by language models, measured in context window limits."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "easy"}}
{"query_id": "rip-eval-058", "query_text": "What is prompt injection and how to prevent it?", "ground_truth": "Prompt injection is when user input overrides system instructions in an LLM application. Prevention includes input sanitization, output validation, and separating user input from system prompts.", "contexts": ["Prompt injection overrides system instructions via user input. Input sanitization helps prevent it."], "label_source": "human-validated", "metadata": {"annotator": "annotator_1", "category": "machine_learning", "difficulty": "medium"}}
{"query_id": "rip-eval-059", "query_text": "What is retrieval latency and why does it matter?", "ground_truth": "Retrieval latency is the time taken to retrieve relevant documents from a vector database. It matters because it directly affects end-to-end RAG response time and user experience.", "contexts": ["Retrieval latency measures vector search time and affects total RAG response time."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "retrieval", "difficulty": "easy"}}
{"query_id": "rip-eval-060", "query_text": "What is embedding model quantization?", "ground_truth": "Quantization reduces embedding model precision (e.g., from float32 to int8) to decrease memory usage and inference time with minimal accuracy loss. Useful for deployment on edge devices.", "contexts": ["Quantization reduces embedding model precision to save memory and computation with minimal accuracy loss."], "label_source": "human-validated", "metadata": {"annotator": "annotator_2", "category": "embeddings", "difficulty": "medium"}}
